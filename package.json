{
	"name": "moq-js",
	"type": "module",
	"workspaces": [
		"lib",
		"catalog",
		"media",
		"player",
		"publisher",
		"samples"
	],
	"scripts": {
		"dev:transport": "npm run dev --workspace=@moq-js/transport",
		"dev:catalog": "npm run dev --workspace=@moq-js/catalog",
		"dev:media": "npm run dev --workspace=@moq-js/media",
		"dev:player": "npm run dev --workspace=@moq-js/player",
		"dev:publisher": "npm run dev --workspace=@moq-js/publisher",
		"start:demo": "node demo/server.cjs",
		"dev": "npm-run-all --parallel dev:transport dev:catalog dev:media dev:player dev:publisher start:demo",
		"sync:demo-lib": "node scripts/sync-demo-lib.mjs",
		"build": "npm run build --workspaces && npm run sync:demo-lib",
		"lint": "npm run lint --workspaces",
		"fmt": "npm run fmt --workspaces"
	},
	"devDependencies": {
		"npm-run-all": "^4.1.5"
	}
}
