{
	"name": "@moq-js/transport",
	"version": "0.4.3",
	"description": "Media over QUIC transport library",
	"license": "(MIT OR Apache-2.0)",
	"type": "module",
	"main": "./dist/transport.cjs.js",
	"module": "./dist/transport.esm.js",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": "./dist/transport.esm.js",
			"require": "./dist/transport.cjs.js"
		}
	},
	"types": "dist/types/transport.d.ts",
	"scripts": {
		"build": "rollup -c rollup.config.cjs",
		"dev": "rollup -c rollup.config.cjs -w",
		"test:transport": "node test/transport.cjs",
		"lint": "eslint . --ext .js,.ts,.jsx,.tsx",
		"fmt": "prettier --write ."
	},
	"devDependencies": {
		"@babel/core": "^7.26.0",
		"rollup-plugin-dts": "^6.1.1",
		"@babel/preset-env": "^7.26.0",
		"@babel/preset-typescript": "^7.26.0",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-commonjs": "^28.0.1",
		"@rollup/plugin-node-resolve": "^15.3.0",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.1.1",
		"@typescript-eslint/eslint-plugin": "^6.4.0",
		"@typescript-eslint/parser": "^6.4.0",
		"@typescript/lib-dom": "npm:@types/web@^0.0.115",
		"cross-env": "^7.0.2",
		"eslint": "^8.47.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"prettier": "^3.0.1",
		"rollup": "^4.28.0",
		"rollup-plugin-sourcemaps": "^0.6.2",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2"
	},
	"dependencies": {},
	"repository": {
		"type": "git",
		"url": "https://github.com/englishm/moq-js"
	}
}
